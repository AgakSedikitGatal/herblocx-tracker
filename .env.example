# Copy this file to .env.local and paste your values there. Never commit .env.local.
# Find the values in Supabase: Project Settings -> API Keys, and the "Connect" button for the URL.

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (starts with sb_publishable_). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts with sb_secret_). SERVER ONLY. Never share it or put it in the browser.
SUPABASE_SECRET_KEY=
